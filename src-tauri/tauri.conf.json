{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpaceLens",
  "version": "0.1.0",
  "identifier": "com.spacelens.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"SpaceLens 空间镜","width":1360,"height":900,"minWidth":960,"minHeight":640}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {"active":true,"targets":["app"],"icon":["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns"],"category":"Utilities","shortDescription":"本地磁盘空间分析","macOS":{"minimumSystemVersion":"14.0"}}
}
