  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.12"
  }
}
