  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "node scripts/run.mjs tauri",
    "desktop": "node scripts/run.mjs tauri dev",
    "desktop:build": "node scripts/run.mjs tauri build --bundles app",
    "test:core": "node scripts/run.mjs cargo test --manifest-path src-tauri/core/Cargo.toml",
    "test:native": "node scripts/run.mjs cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "lucide-react": "^0.468.0",
